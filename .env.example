DATABASE_URL=postgresql://translator:translator@localhost:5432/translator
REDIS_URL=redis://localhost:6379/0
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
CACHE_TTL_SECONDS=3600

# Standard OpenAI rates in USD per 1M tokens, checked October 2026.
# These are not cached-input or batch rates. Update them if the price page changes.
MODEL_A_NAME=gpt-4.1-mini
MODEL_A_INPUT_PRICE_PER_MILLION=0.40
MODEL_A_OUTPUT_PRICE_PER_MILLION=1.60
MODEL_B_NAME=gpt-4.1
MODEL_B_INPUT_PRICE_PER_MILLION=2.00
MODEL_B_OUTPUT_PRICE_PER_MILLION=8.00
